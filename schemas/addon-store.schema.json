{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wealthfolio.app/schemas/addon-store.schema.json",
  "title": "Wealthfolio Addon Store Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "trust", "status", "tags"],
  "$defs": {
    "httpsUrl": {
      "description": "HTTPS URL without embedded credentials.",
      "type": "string",
      "maxLength": 500,
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\s]*)?$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+[a-z0-9-]*[a-z0-9]$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "description": "Plain text only. Rendered without markup by the website.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "author": {
      "description": "The publisher responsible for the addon, not merely the GitHub account that opened the pull request.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "url": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        }
      ]
    },
    "trust": {
      "description": "official: built, distributed, and supported by Wealthfolio. community: independently published, linked from the directory only.",
      "enum": ["official", "community"]
    },
    "status": {
      "description": "pending: submitted but not yet confirmed by the publisher; excluded from the public directory.",
      "enum": ["active", "pending", "coming-soon", "deprecated", "inactive"]
    },
    "featured": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "repository": {
      "$ref": "#/$defs/httpsUrl"
    },
    "supportUrl": {
      "$ref": "#/$defs/httpsUrl"
    },
    "privacyUrl": {
      "$ref": "#/$defs/httpsUrl"
    },
    "license": {
      "description": "SPDX identifier of the license the published source is available under.",
      "enum": [
        "AGPL-3.0-only",
        "AGPL-3.0-or-later",
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "BSL-1.0",
        "CC0-1.0",
        "EPL-2.0",
        "GPL-2.0-only",
        "GPL-2.0-or-later",
        "GPL-3.0-only",
        "GPL-3.0-or-later",
        "ISC",
        "LGPL-2.1-only",
        "LGPL-2.1-or-later",
        "LGPL-3.0-only",
        "LGPL-3.0-or-later",
        "MIT",
        "MPL-2.0",
        "Unlicense",
        "Zlib"
      ]
    },
    "minWealthfolioVersion": {
      "description": "Lowest Wealthfolio version the publisher declares the addon works with. Declared by the publisher; not tested by Wealthfolio.",
      "$ref": "#/$defs/semver"
    },
    "commercialModel": {
      "description": "external-service-required does not imply the required service is free.",
      "enum": ["free", "paid", "subscription", "external-service-required"]
    },
    "notices": {
      "description": "Standard notices the website renders. Publishers select from this list; they do not write custom disclaimer copy.",
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["not-tax-advice", "not-investment-advice", "not-financial-advice"]
      }
    },
    "dataHandling": {
      "description": "Publisher declaration about what the addon does with portfolio data. Informational only: the Wealthfolio install dialog remains the authoritative permission surface.",
      "type": "object",
      "additionalProperties": false,
      "required": ["leavesDevice", "dataTypes", "externalServices"],
      "properties": {
        "leavesDevice": {
          "description": "true when any data is sent off the user's device for any reason.",
          "type": "boolean"
        },
        "dataTypes": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "accounts",
              "account-balances",
              "holdings",
              "transactions",
              "activities",
              "performance-metrics",
              "goals",
              "symbols-quotes",
              "market-data",
              "api-credentials",
              "personal-identifiers",
              "other"
            ]
          }
        },
        "externalServices": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "url": {
                "$ref": "#/$defs/httpsUrl"
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {
          "$ref": "#/$defs/httpsUrl"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "commit": {
          "type": "string",
          "minLength": 7,
          "maxLength": 40,
          "pattern": "^[a-f0-9]{7,40}$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "minWealthfolioVersion"],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "minWealthfolioVersion": {
          "$ref": "#/$defs/semver"
        },
        "sdkVersion": {
          "$ref": "#/$defs/semver"
        },
        "critical": {
          "type": "boolean"
        },
        "breaking": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "changelogUrl": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "distribution": {
      "description": "Wealthfolio-hosted artifact. Official addons only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["r2Path"],
      "properties": {
        "r2Path": {
          "description": "Canonical key: {id}/{id}-{version}.zip",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "downloadUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverLight": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "coverDark": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "trust": { "const": "official" } },
        "required": ["trust"]
      },
      "then": {
        "required": ["release", "distribution", "media"]
      }
    },
    {
      "if": {
        "properties": { "trust": { "const": "community" } },
        "required": ["trust"]
      },
      "then": {
        "required": ["name", "description", "author", "repository"],
        "not": { "required": ["distribution"] }
      }
    },
    {
      "if": {
        "properties": {
          "trust": { "const": "community" },
          "status": { "const": "active" }
        },
        "required": ["trust", "status"]
      },
      "then": {
        "required": [
          "license",
          "supportUrl",
          "minWealthfolioVersion",
          "commercialModel",
          "dataHandling",
          "notices"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "dataHandling": {
            "type": "object",
            "properties": { "leavesDevice": { "type": "boolean", "const": true } },
            "required": ["leavesDevice"]
          }
        },
        "required": ["dataHandling"]
      },
      "then": {
        "required": ["privacyUrl"]
      }
    },
    {
      "if": {
        "properties": {
          "dataHandling": {
            "type": "object",
            "properties": { "leavesDevice": { "type": "boolean", "const": false } },
            "required": ["leavesDevice"]
          }
        },
        "required": ["dataHandling"]
      },
      "then": {
        "properties": {
          "dataHandling": {
            "type": "object",
            "properties": {
              "externalServices": { "type": "array", "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataHandling": {
            "type": "object",
            "properties": {
              "externalServices": { "type": "array", "minItems": 1 }
            },
            "required": ["externalServices"]
          }
        },
        "required": ["dataHandling"]
      },
      "then": {
        "properties": {
          "dataHandling": {
            "type": "object",
            "properties": {
              "leavesDevice": { "type": "boolean", "const": true }
            }
          }
        }
      }
    }
  ]
}
